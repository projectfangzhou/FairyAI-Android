<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FairyAI_Android.Pages.DeviceAdaptivePage"
             BackgroundColor="#1a1a2e"
             Title="FairyAI">
    <!-- iPhone: single column, bottom tabs -->
    <!-- iPad: split-view with sidebar -->
    <!-- Mac: multi-window with menu bar -->
    <!-- Watch: minimal with crown -->
    <Grid x:Name="MainGrid" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8" Padding="0,0,0,12">
            <Label Text="🧚 FairyAI" TextColor="#7b68ee" FontSize="20" FontAttributes="Bold"/>
            <Label x:Name="DeviceLabel" Text="" TextColor="#888" FontSize="12" VerticalOptions="End"/>
        </HorizontalStackLayout>

        <!-- Content area - adapts to device -->
        <Grid Grid.Row="1" x:Name="ContentGrid">
            <!-- Phone: single column -->
            <VerticalStackLayout x:Name="PhoneLayout" Spacing="12">
                <Frame BackgroundColor="#2a2a3e" CornerRadius="12" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="💬 对话" TextColor="#7b68ee" FontSize="16" FontAttributes="Bold"/>
                        <Editor x:Name="ChatEditor" BackgroundColor="#16162a" TextColor="#ddd" HeightRequest="200" FontSize="14"/>
                        <Button Text="发送" BackgroundColor="#7b68ee" TextColor="White" Clicked="OnSendClicked"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- Tablet: sidebar + content -->
            <Grid x:Name="TabletLayout" ColumnSpacing="12" IsVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Frame Grid.Column="0" BackgroundColor="#2a2a3e" CornerRadius="12" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="📚 导航" TextColor="#7b68ee" FontSize="14" FontAttributes="Bold"/>
                        <Button Text="对话" BackgroundColor="#333" TextColor="#ddd" Clicked="OnNavChat"/>
                        <Button Text="知识库" BackgroundColor="#333" TextColor="#ddd" Clicked="OnNavKnowledge"/>
                        <Button Text="设置" BackgroundColor="#333" TextColor="#ddd" Clicked="OnNavSettings"/>
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="1" BackgroundColor="#2a2a3e" CornerRadius="12" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="💬 对话" TextColor="#7b68ee" FontSize="16" FontAttributes="Bold"/>
                        <Editor x:Name="TabletChatEditor" BackgroundColor="#16162a" TextColor="#ddd" HeightRequest="300" FontSize="15"/>
                        <Button Text="发送" BackgroundColor="#7b68ee" TextColor="White" Clicked="OnSendClicked"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Watch: minimal -->
            <VerticalStackLayout x:Name="WatchLayout" Spacing="12" IsVisible="False">
                <Label Text="🧚 FairyAI" TextColor="#7b68ee" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Button Text="🎤 语音" BackgroundColor="#7b68ee" TextColor="White" HeightRequest="60" Clicked="OnVoiceClicked"/>
                <Button Text="💬 消息" BackgroundColor="#2a2a3e" TextColor="#ddd" HeightRequest="60" Clicked="OnNavChat"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Footer -->
        <HorizontalStackLayout Grid.Row="2" Spacing="8" Padding="0,12,0,0">
            <Button x:Name="VoiceBtn" Text="🎤" WidthRequest="48" HeightRequest="48" BackgroundColor="#7b68ee" TextColor="White" Clicked="OnVoiceClicked"/>
            <Button x:Name="SettingsBtn" Text="⚙" WidthRequest="48" HeightRequest="48" BackgroundColor="#2a2a3e" TextColor="#ddd" Clicked="OnNavSettings"/>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
